# HTTP listen port for the API process
PORT=3000

# Redis connection string (DB 0 for app data; tests use /1)
REDIS_URL=redis://localhost:6379

# Optional override for npm run test:integration (defaults to redis://localhost:6379/1)
# TEST_REDIS_URL=redis://localhost:6379/1

# Temporal frontend address (host:port)
TEMPORAL_ADDRESS=localhost:7233

# Temporal namespace used by the worker and client
TEMPORAL_NAMESPACE=default

# Task queue shared by the worker and workflow starts
TEMPORAL_TASK_QUEUE=hotel-offers

# Mock Supplier A base URL (no trailing slash). Inside Compose use http://api:3000/supplierA
SUPPLIER_A_URL=http://localhost:3000/supplierA

# Mock Supplier B base URL (no trailing slash). Inside Compose use http://api:3000/supplierB
SUPPLIER_B_URL=http://localhost:3000/supplierB

# Abort supplier HTTP calls after this many ms (must stay below activity startToCloseTimeout of 3s)
SUPPLIER_TIMEOUT_MS=2500

# Redis TTL for a full successful (non-degraded) hotel list
CACHE_TTL_SECONDS=600

# Redis TTL when one supplier failed (degraded results)
DEGRADED_TTL_SECONDS=60

# How long the API waits for a workflow result before returning 504 (workflow is not terminated)
WORKFLOW_WAIT_MS=8000

# Mount POST/GET /__chaos routes (never enable in real production)
ENABLE_CHAOS=false

# If set, chaos routes require matching header x-chaos-token
CHAOS_TOKEN=

# Auto-revert non-ok chaos modes after this many seconds
CHAOS_TTL_SECONDS=60

# pino log level: fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info
