            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('still 200 with Supplier A results only', () => {",
                  "  pm.response.to.have.status(200);",
                  "  body.forEach((h) => pm.expect(h.supplier).to.eql('Supplier A'));",
                  "});",
                  "pm.test('X-Degraded: true and X-Failed-Suppliers: supplierB', () => {",
                  "  pm.expect(pm.response.headers.get('X-Degraded')).to.eql('true');",
                  "  pm.expect(pm.response.headers.get('X-Failed-Suppliers')).to.include('supplierB');",
                  "});",
                  "pm.test('Holtin now comes from Supplier A at 6000', () => {",
                  "  pm.expect(body.find((h) => h.name === 'Holtin')).to.eql({ name: 'Holtin', price: 6000, supplier: 'Supplier A', commissionPct: 10 });",
