{
  "info": {
    "_postman_id": "a3b9658b-f86c-54e3-9b7a-c1d8b15394b3",
    "name": "Hotel Offer Orchestrator",
    "description": "Tests for the Tripare AI take-home.\n\nConventions:\n- `{{baseUrl}}` comes from the selected environment (local or live).\n- Every request has `pm.test` assertions; run everything with newman (`npm run test:postman`).\n- Run folders in order: \"Cache\" expects \"Happy path\" first; \"Resilience\" must run top to bottom.\n- Response items always have exactly: name, price, supplier, commissionPct.\n- Errors always look like `{\"error\":{\"code\",\"message\",\"details?\"}}`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('responds in under 10s', () => pm.expect(pm.response.responseTime).to.be.below(10000));",
          "pm.test('JSON response with an X-Request-Id', () => {",
          "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "  pm.expect(pm.response.headers.has('X-Request-Id')).to.be.true;",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Health",
      "description": "`GET /health` reports both suppliers, Redis and Temporal (including whether a worker is polling the task queue).",
      "item": [
        {
          "name": "Health is ok",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('200 and status ok', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(b.status).to.eql('ok');",
                  "});",
                  "pm.test('reports both suppliers, Redis and Temporal (with a polling worker)', () => {",
                  "  ['supplierA', 'supplierB', 'redis', 'temporal'].forEach((d) => pm.expect(b.dependencies[d].status).to.eql('ok'));",
                  "  pm.expect(b.dependencies.temporal.workerPolling.status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Bonus requirement: health of both suppliers (plus Redis, Temporal, worker)."
          }
        }
      ]
    },
    {
      "name": "2. Happy path",
      "description": "Valid cities with overlapping hotels between Supplier A and B.",
      "item": [
        {
          "name": "Delhi: dedupe + best price (fresh run)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200 and a bare JSON array', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(body).to.be.an('array').that.is.not.empty;",
                  "});",
                  "pm.test('every item has exactly name, price, supplier, commissionPct', () => {",
                  "  body.forEach((h) => pm.expect(Object.keys(h).sort()).to.eql(['commissionPct', 'name', 'price', 'supplier']));",
                  "});",
                  "pm.test('no duplicate hotels (case/space/punctuation-insensitive)', () => {",
                  "  const keys = body.map((h) => h.name.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim());",
                  "  pm.expect(new Set(keys).size).to.eql(keys.length);",
                  "});",
                  "pm.test('no untrimmed display names', () => {",
                  "  body.forEach((h) => pm.expect(h.name).to.eql(h.name.trim()));",
                  "});",
                  "pm.test('sorted by price ascending', () => {",
                  "  const prices = body.map((h) => h.price);",
                  "  pm.expect(prices).to.eql([...prices].sort((a, b) => a - b));",
                  "});",
                  "const byName = Object.fromEntries(body.map((h) => [h.name, h]));",
                  "pm.test('Holtin: Supplier B wins on price (5340 / 20%)', () => {",
                  "  pm.expect(byName['Holtin']).to.eql({ name: 'Holtin', price: 5340, supplier: 'Supplier B', commissionPct: 20 });",
                  "});",
                  "pm.test('Radison: Supplier A wins on price (5900 / 13%)', () => {",
                  "  pm.expect(byName['Radison']).to.eql({ name: 'Radison', price: 5900, supplier: 'Supplier A', commissionPct: 13 });",
                  "});",
                  "pm.test('Oberoi: equal price -> higher commission wins (Supplier B, 18%)', () => {",
                  "  pm.expect(byName['Oberoi']).to.include({ price: 8000, supplier: 'Supplier B', commissionPct: 18 });",
                  "});",
                  "pm.test('ITC Maurya: equal price + commission -> Supplier A; variant \"  ITC   MAURYA \" deduped', () => {",
                  "  pm.expect(byName['ITC Maurya']).to.include({ price: 7000, supplier: 'Supplier A' });",
                  "});",
                  "pm.test('single-supplier hotels are kept (Lodhi from A, The Imperial from B)', () => {",
                  "  pm.expect(byName['Lodhi'].supplier).to.eql('Supplier A');",
                  "  pm.expect(byName['The Imperial'].supplier).to.eql('Supplier B');",
                  "});",
                  "pm.test('10 unique Delhi hotels after dedupe', () => pm.expect(body.length).to.eql(10));",
                  "pm.test('X-Cache: REFRESH (forced a fresh workflow run)', () => pm.expect(pm.response.headers.get('X-Cache')).to.eql('REFRESH'));",
                  "pm.test('not degraded', () => pm.expect(pm.response.headers.has('X-Degraded')).to.be.false);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi&refresh=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                },
                {
                  "key": "refresh",
                  "value": "true"
                }
              ]
            },
            "description": "Runs the Temporal workflow (`refresh=true`) and checks every business rule: cheaper wins; equal price -> higher commission -> Supplier A; name variants deduped; single-supplier hotels kept; exact response shape; sorted by price."
          }
        },
        {
          "name": "Mumbai",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200 array, 10 unique hotels, four keys each', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(body).to.have.lengthOf(10);",
                  "  body.forEach((h) => pm.expect(Object.keys(h).sort()).to.eql(['commissionPct', 'name', 'price', 'supplier']));",
                  "});",
                  "const byName = Object.fromEntries(body.map((h) => [h.name, h]));",
                  "pm.test('Holtin in Mumbai: Supplier B 4990', () => pm.expect(byName['Holtin']).to.include({ price: 4990, supplier: 'Supplier B' }));",
                  "pm.test('\"St Regis\" and \"The St. Regis Mumbai\" stay separate (no fuzzy matching)', () => {",
                  "  pm.expect(byName).to.have.property('St Regis');",
                  "  pm.expect(byName).to.have.property('The St. Regis Mumbai');",
                  "});",
                  "pm.test('sorted by price ascending', () => {",
                  "  const p = body.map((h) => h.price);",
                  "  pm.expect(p).to.eql([...p].sort((a, b) => a - b));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=mumbai&refresh=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "mumbai"
                },
                {
                  "key": "refresh",
                  "value": "true"
                }
              ]
            },
            "description": "Second city with its own overlaps; shows there is no fuzzy matching."
          }
        }
      ]
    },
