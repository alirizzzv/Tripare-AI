              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const min = 5340, max = null;",
                  "pm.test('200 and every price within the inclusive range', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(body).to.be.an('array').that.is.not.empty;",
                  "  body.forEach((h) => {",
                  "    if (min !== null) pm.expect(h.price).to.be.at.least(min);",
                  "    if (max !== null) pm.expect(h.price).to.be.at.most(max);",
                  "  });",
                  "});",
                  "pm.test('expected hotels present: Holtin, Radison', () => {",
                  "  const names = body.map((h) => h.name);",
