    {
      "name": "7. Resilience (chaos, optional)",
      "description": "Simulates supplier outages with the in-memory chaos switch (`ENABLE_CHAOS=true`; token from the `chaosToken` environment variable). ORDER MATTERS: run top to bottom. The first and last requests reset chaos, and every non-ok mode also auto-reverts after 60s, so a demo can never stay broken.",
      "item": [
        {
          "name": "Reset chaos (start clean)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('chaos reset: both suppliers ok', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.supplierA.mode).to.eql('ok');",
                  "  pm.expect(b.supplierB.mode).to.eql('ok');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-chaos-token",
                "value": "{{chaosToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/__chaos/reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "__chaos",
                "reset"
