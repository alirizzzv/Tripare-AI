{
  "name": "hotel-offer-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Hotel Offer Orchestrator — Tripare AI take-home",
  "engines": {
    "node": ">=20.3.0 <25"
  },
  "scripts": {
    "dev:api": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/temporal/worker.ts",
    "build": "tsc -p tsconfig.build.json && node dist/temporal/bundleWorkflows.js",
    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/temporal/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:postman": "npx --yes newman@6.2.3 run postman/Hotel-Offer-Orchestrator.postman_collection.json -e postman/local.postman_environment.json",
    "test:postman:live": "npx --yes newman@6.2.3 run postman/Hotel-Offer-Orchestrator.postman_collection.json -e postman/live.postman_environment.json",
    "smoke": "bash scripts/smoke.sh",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@temporalio/activity": "1.26.0",
    "@temporalio/client": "1.26.0",
    "@temporalio/common": "1.26.0",
    "@temporalio/worker": "1.26.0",
    "@temporalio/workflow": "1.26.0",
    "express": "5.3.0",
    "ioredis": "6.0.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@temporalio/testing": "1.26.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "pino-pretty": "13.2.0",
    "prettier": "3.10.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
